# Copy to backend/.env and fill in. Never commit the real file.
ENVIRONMENT=development
BRAND_NAME=Aurevia
# Real MongoDB (Docker Compose uses mongodb://mongo:27017). Use mongomock:// for a no-install in-memory dev DB.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=aurevia
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Used in PDF QR codes
PUBLIC_SITE_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
ENQUIRY_RATE_PER_MINUTE=5
ENQUIRY_RATE_PER_HOUR=20
LOGIN_RATE_PER_MINUTE=10
TRUST_PROXY=false
# First admin, created by `python -m app.seed`
SEED_ADMIN_EMAIL=admin@aurevia.example
SEED_ADMIN_PASSWORD=
